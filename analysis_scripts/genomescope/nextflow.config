/*
 * Nextflow Configuration — FastK + GenomeScope 2.0
 * Shared by both run_illumina.sh and run_aviti.sh
 */

manifest {
    name            = 'GenomeScope K-mer Analysis (FastK)'
    version         = '3.0.0'
    description     = 'K-mer spectrum analysis using FastK + GenomeScope 2.0'
    nextflowVersion = '>=24.04.0'
}

params {
    output_dir   = "./genomescope_results"
    k            = 21
    ploidy       = 2
    threads      = 35
    memory_gb    = 70
    subsample    = false
    target_bases = null
}

process {
    cpus   = 50
    memory = 80.GB
    time   = 15.h
    errorStrategy = 'terminate'

    withName: 'SUBSAMPLE_READS' {
        cpus   = 50
        memory = 80.GB
        time   = 12.h
    }

    withName: 'FASTK_COUNT' {
        cpus   = { params.threads }
        memory = { "${params.memory_gb}.GB" }
        time   = 2.h
    }

    withName: 'HISTEX_EXPORT' {
        cpus   = 10
        memory = 40.GB
        time   = 30.m
    }

    withName: 'GENOMESCOPE' {
        cpus   = 10
        memory = 40.GB
        time   = 30.m
    }
}

executor {
    name   = 'local'
    cpus   = 60
    memory = 100.GB
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

cleanup  = false
report   { enabled = false }
timeline { enabled = false }
trace    { enabled = false }
