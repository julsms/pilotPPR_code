// Process configuration
process {
    withName: 'NORMALIZE_VCF' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
        maxForks = 2  // Run both normalizations simultaneously
    }
    
    withName: 'EXTRACT_REGIONS' {
        cpus = 2
        memory = '4.GB'
        time = '1.h'
        maxForks = 10  // Run up to 10 region extractions simultaneously
    }
}

// Executor configuration
executor {
    name = 'local'
    cpus = 40
    memory = '40.GB'
}

// Enable reports
timeline {
    enabled = true
    overwrite = true 
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

// Default parameters
params {
    query_vcf = null
    gold_vcf = "/mnt/genomics/illumina/v5.0/HG002_GRCh38_v5.0q_smvar.vcf.gz"
    reference = "/mnt/genomics/illumina/ref/Homo_sapiens.GRCh38.dna.primary_assembly.fa"
    bed_dir = "/mnt/genomics/GIAB_stratifications/v3.6/no_chr"
    outdir = null
    
    bed_files = [
        "TRHP.bed","LM.bed", "OD.bed", "AD.bed", "25GC65.bed", "15GC85.bed", "REFSEQ.bed", "BB.bed", "ACMG.bed", "OMIM.bed"
    ]
}
