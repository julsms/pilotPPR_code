// Global default params
params {
    // Input parameters
    reads = null
    sample_name = null
    outdir = "results"

    // Optional workflows
    run_deepvariant = false

    // Reference paths
    graph_dir = "/mnt/genomics/HPRC_v1.1_default"
    graph_gbz = "${params.graph_dir}/hprc-v1.1-mc-grch38.gbz"
    graph_hapl = "${params.graph_dir}/graph.hapl"
    reference_dir = "/mnt/genomics/illumina/ref_chr"
    reference_fasta = "${params.reference_dir}/Homo_sapiens.GRCh38.dna.primary_assembly.fasta"

    // Resource limits
    max_cpus = 70
    max_memory = 150.GB
    max_time = 48.h
}

// Process configuration
process {
    // Global process settings
    executor = 'local'

    // Default resources
    cpus = 4
    memory = 8.GB
    time = 2.h

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2

    // Process-specific resources
    withName: KMC_COUNT {
        cpus = 70
        memory = 120.GB
        time = 4.h
    }

    withName: HAPLOTYPE_SAMPLING {
        cpus = 70
        memory = 140.GB
        time = 5.h
    }

    withName: VG_GIRAFFE {
        cpus = 70
        memory = 140.GB
        time = 8.h
    }

    withName: VG_PACK {
        cpus = 40
        memory = 100.GB
        time = 8.h
    }

    withName: VG_CALL {
        cpus = 70
        memory = 120.GB
        time = 8.h
    }

    withName: COMPRESS_INDEX_VCF {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }

    // Small variants processes
    withName: VG_VIEW {
        cpus = 50
        memory = 120.GB
        time = 4.h
    }

    withName: VG_INDEX_XG {
        cpus = 70
        memory = 100.GB
        time = 7.h
    }

    withName: VG_SURJECT {
        cpus = 70
        memory = 100.GB
        time = 8.h
    }

    withName: BAM_PREPROCESSING {
        cpus = 40
        memory = 145.GB
        time = 6.h
    }

    withName: DEEPVARIANT {
        cpus = 40
        memory = 90.GB
        time = 8.h
    }
}

// Docker configuration
docker {
    enabled = true
    runOptions = "--user \$(id -u):\$(id -g) -v /mnt/genomics/HPRC_v1.1_default:/graph -v /mnt/genomics/illumina/ref_chr:/reference"
}

// Execution reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
